{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "watchPatterns": [
      "services/workers/**",
      "packages/**",
      "infrastructure/db/**",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "package.json",
      "tsconfig.base.json",
      "tools/signal-semantic-lab/src/**"
    ],
    "dockerfilePath": "services/workers/Dockerfile"
  },
  "deploy": {
    "startCommand": "pnpm --filter @noisia/workers start",
    "restartPolicyType": "ALWAYS",
    "restartPolicyMaxRetries": 10
  }
}
