NEXT_PUBLIC_SITE_URL=https://noisia.ai
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Workshop form delivery (Resend). Without a key the request is logged on the server.
RESEND_API_KEY=
WORKSHOP_FROM_EMAIL=contacto@noisia.ai
WORKSHOP_TO_EMAIL=hola@noisia.ai
# Study emails (code and access link). The sender must be on a domain verified in Resend (hey.noisia.ai).
STUDY_FROM_EMAIL=Noisia <estudios@hey.noisia.ai>
# Replies to the access email, and the "Registro" note for each new reader. Both fall back to WORKSHOP_TO_EMAIL.
STUDY_REPLY_TO=
STUDY_NOTIFY_TO=
# Booking page behind noisia.ai/agenda (the address in the study decks). Empty: it opens the contact form.
NOISIA_AGENDA_URL=
# Staging only: ask for this password on every page and keep search engines out.
UAT_PASSWORD=
NOISIA_UAT=
# Staging only: load the invented demo stories (src/content/stories/demo). Never in production.
NOISIA_DEMO_STORIES=
# Content database (its own Supabase project; see content-db/README.md). Without it the site
# reads the Insights pieces from src/content/stories/public, as before.
# Production connects as website_runtime; UAT as website_review (also sees drafts).
CONTENT_DATABASE_URL=
# Optional: Supabase's root certificate (PEM) so the connection checks the server.
CONTENT_DATABASE_CA=
# Shared with the publish script: lets it refresh the feed without a deploy.
CONTENT_REVALIDATE_SECRET=
# Content scripts only, never the site: draws each study's image (pnpm content:image). It lives in
# the repo root's .env.local with the other tool keys.
OPENAI_API_KEY=
