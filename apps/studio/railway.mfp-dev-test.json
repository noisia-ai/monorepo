{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/studio/Dockerfile.mfp-dev-test",
    "watchPatterns": [
      "apps/studio/**",
      "services/workers/**",
      "packages/**",
      "infrastructure/db/**",
      "docs/api/openapi.yaml",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "package.json",
      "tsconfig.base.json"
    ]
  },
  "deploy": {
    "startCommand": "sh apps/studio/start-mfp-dev-test.sh",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
