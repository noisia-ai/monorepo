# Copy to .env (ignored by git) and fill in. Never commit the real values.
# Remotion company license (remotion.pro): the secret key is passed to every automated render.
REMOTION_LICENSE_KEY=
# Public key, used by the Studio (non-billed development renders).
REMOTION_PUBLIC_LICENSE_KEY=
# Optional: a local chrome-headless-shell, so Remotion does not download its own.
# CHROME_EXECUTABLE=~/Library/Caches/ms-playwright/chromium_headless_shell-1254/chrome-headless-shell-mac-arm64/chrome-headless-shell
